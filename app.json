{
  "expo": {
    "name": "AlgoTMS54",
    "slug": "AlgoTMS54",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow AlgoTMS to use your camera to scan barcodes.",
        "NSPhotoLibraryAddUsageDescription": "Allow AlgoTMS to save captured images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/algo3.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.saquib25.AlgoTMS54"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AlgoTMS to access your camera."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b8816f33-f5f4-409a-b5ec-b7e198c520bf"
      }
    }
  }
}
